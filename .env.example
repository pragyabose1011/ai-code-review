# Auth (generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_long_random_string_in_production

# MySQL — used by both Docker Compose and backend
DB_USER=aiuser
DB_PASSWORD=aipass
DB_NAME=ai_review
MYSQL_ROOT_PASSWORD=rootpass

# Ollama — override if not running on localhost
# Docker default (Mac/Windows): http://host.docker.internal:11434
# Linux Docker: http://172.17.0.1:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Frontend URL (for CORS — set to your domain when deploying)
FRONTEND_URL=http://localhost:5174
